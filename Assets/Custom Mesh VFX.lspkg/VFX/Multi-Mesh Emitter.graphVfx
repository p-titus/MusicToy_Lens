        Node4:
          DependencyIndex: 36
          LevelID: 18
          NodeCount: 0
          NodeType: 1
          Ports:
            Code:
              ClassType1: TEXT
              String: |-
                input_int SizeMode;
                input_float InputA; 
                input_float InputB; 
                output_float OutputA; 
                output_float OutputB; 
                
                void main()
                {
                	OutputA = InputA;
                	OutputB = InputB;
                
                	if (SizeMode != 0){
                		float scaleSize = length(system.getAABBMaxLocal() - system.getAABBMinLocal());
                		OutputA /=  scaleSize;
                		OutputB /= scaleSize;
                	}
                }
