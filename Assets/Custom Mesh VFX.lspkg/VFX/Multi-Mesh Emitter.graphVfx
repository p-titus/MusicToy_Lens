    Node15:
      DependencyIndex: 101
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_int NumMeshes;
            input_int SelectMode;
            input_int  MeshID;
            output_vec3 Position; 
            output_float ComparisonID; 
            
            void main()
            {
            	Position = system.getSurfacePosition();
            
            	float colorId = system.getSurfaceColor().r;
            	float numMeshesF = float(NumMeshes);	
            	colorId = floor(colorId * numMeshesF);
            
            	if(SelectMode == 0){
            		ComparisonID = mod(float(system.getParticleIndex()), float(NumMeshes));
            	}
            	if(SelectMode == 1){
            		float rand = system.getParticleRandomFloat( true, true, false, 0.0 );
            		ComparisonID = floor(mix(0.0, float(NumMeshes), rand));
            	}
            	if(SelectMode == 2){
            		ComparisonID = float(MeshID);
            	}
            	
            	if (colorId != ComparisonID) {
            		Position = vec3(1337.0);
            	}
            }
        ComparisonID:
          IOType: 1
          Variable: 0.0
        Description:
          ClassType1: TEXT
          String: |-
            This asset demonstrates how to emit custom multi-mesh with VFX.
            
            The input mesh consists of five submesh primitives, each assigned a value 
            between 0 and 1. The value is determined by dividing the mesh ID by the 
            total number of meshes and storing it in the red channel of the vertex color 
            (vertexColor.r = mesh ID / number of meshes).
            
            For each particle, the submesh ID is compared to determine which mesh to 
            use, while the rest are discarded.
        Examples:
          ItemIndex: 0
          ItemList: "Custom : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        MeshID:
          Connection0:
            NodeLevelID: 32
            PortID: Output
          Variable: 0.0
        NumMeshes:
          Connection0:
            NodeLevelID: 30
            PortID: Output
          Variable: 0.0
        Position:
          IOType: 1
          Variable: [0.0, 0.0, 0.0]
        SelectMode:
          Connection0:
            NodeLevelID: 31
            PortID: Output
          Variable: 0.0
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Select Mesh
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 1.0.0
      PositionX: -948
      PositionY: 1003
      TemplateID: node_util_custom
      TemplateVersionMinor: 2
      Title1: Select Mesh
