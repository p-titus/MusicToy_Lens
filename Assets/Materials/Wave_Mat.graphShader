    Node15:
      DependencyIndex: 15
      LevelID: 13
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_vec4 Wave0;
            input_vec4 Wave1;
            input_vec4 Wave2;
            input_vec4 Wave3;
            input_vec4 Wave4;
            input_vec4 Wave5;
            input_vec4 Wave6;
            input_vec4 Wave7;
            input_vec4 Shape;   // x speed cm/s, y length cm, z width cm, w trail
            input_vec4 Misc;    // x quad side cm, y falloff, z edge fade cm
            input_color3 Colour;
            input_vec4 Kind0;   // 1 = wave 0..3 is a finger tap, 0 = a toy wave
            input_vec4 Kind1;   // same for waves 4..7
            input_color3 TapColour;
            input_float Gain;
            output_vec4 Result;
            
            // height of ONE wave at point p (uv, 0..1). w.xy = start, w.z = age (s), w.w = strength (0 = empty slot)
            // Misc.w = start radius (cm): the front begins on this circle and nothing is drawn inside it
            float waveHeight(vec4 w, vec2 p) {
                if (w.w <= 0.0) {
                    return 0.0;
                }
                float r0     = max(Misc.w, 0.0);                   // start radius (cm)
                float lam    = max(Shape.y, 0.05);                 // wavelength (cm)
                float d      = length(p - w.xy) * Misc.x;          // cm from the wave's start
                float travel = Shape.x * w.z;                      // how far the front has moved since it started (cm)
                float x      = d - (r0 + travel);                  // negative = behind the front
            
                // the packet can't be bigger than the distance it has travelled
                float grow  = max(travel, 0.5 * lam);
                float width = x > 0.0 ? Shape.z : Shape.z * max(Shape.w, 0.01);
                float sigma = max(min(width, grow), 0.01);
            
                float e   = x / sigma;
                float env = exp(-e * e);
            
                // hide everything inside the start circle, with a soft edge
                float inside = smoothstep(r0 - max(0.25 * Shape.z, 0.001), r0, d);
            
                float spread = sqrt(1.0 + max(Misc.y, 0.0) * travel / lam);   // amplitude falloff with distance travelled
                return inside * w.w * env * cos(6.2831853 * x / lam) / spread;
            }
            
            void main() {
                vec2 p = system.getSurfaceUVCoord0();
                float h0 = waveHeight(Wave0, p);
                float h1 = waveHeight(Wave1, p);
                float h2 = waveHeight(Wave2, p);
                float h3 = waveHeight(Wave3, p);
                float h4 = waveHeight(Wave4, p);
                float h5 = waveHeight(Wave5, p);
                float h6 = waveHeight(Wave6, p);
                float h7 = waveHeight(Wave7, p);
                float h = h0 + h1 + h2 + h3 + h4 + h5 + h6 + h7;
                // how much of the water here comes from tap waves (0..1), by the size of each wave's height
                float tapSum = abs(h0) * Kind0.x + abs(h1) * Kind0.y + abs(h2) * Kind0.z + abs(h3) * Kind0.w
                             + abs(h4) * Kind1.x + abs(h5) * Kind1.y + abs(h6) * Kind1.z + abs(h7) * Kind1.w;
                float allSum = abs(h0) + abs(h1) + abs(h2) + abs(h3) + abs(h4) + abs(h5) + abs(h6) + abs(h7);
                float tapShare = clamp(tapSum / (allSum + 0.0001), 0.0, 1.0);
                vec3 col = mix(Colour, TapColour, tapShare);
                // fade to nothing before the quad edge (Misc.z cm), so the edge is never seen
                float from = clamp(1.0 - Misc.z / max(0.5 * Misc.x, 0.01), 0.0, 0.99);
                float edge = 1.0 - smoothstep(from, 1.0, length(p - vec2(0.5)) * 2.0);
                float b = clamp(h, 0.0, 1.0) * edge * Gain;       // crests only: a crest + a trough cancel
                Result = vec4(col * b, 1.0);
            }
        Colour:
          ClassType1: COLOR
          Connection0:
            NodeLevelID: 11
            PortID: Output
          Variable: [1.0, 1.0, 1.0, 1.0]
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        Gain:
          Connection0:
            NodeLevelID: 12
            PortID: Output
          Variable: 0.0
        ID:
          Variable: 13
        Kind0:
          Connection0:
            NodeLevelID: 14
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        Kind1:
