  InputLines:
    - '// @input Component.RenderMeshVisual visual {"hint":"The RenderMeshVisual that shows the handle. Empty = the one on this object."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Handle shape</span>"}'
    - '// @ui {"widget":"group_start", "label":"Handle shape"}'
    - '// @input float width = 8 {"hint":"Width of the flat edge, left to right (cm).", "widget":"slider", "min":2, "max":20, "step":0.1}'
    - '// @input float depth = 3 {"hint":"Depth at the centre, from the flat edge to the pull point toward the user (cm).", "widget":"slider", "min":0.5, "max":10, "step":0.1}'
    - '// @input float endDepthPercent = 35 {"hint":"Taper: depth at the two ends as a percentage of the centre depth. 100 = no taper (a plain half rounded rectangle), 0 = the ends come to nothing (a pure half ellipse when Corner Roundness is 1). Percent.", "widget":"slider", "min":0, "max":100, "step":1}'
    - '// @input float cornerRoundness = 0.6 {"hint":"Corner roundness. 1 = smooth half ellipse, 0 = nearly square corners. 0 to 1, no unit.", "widget":"slider", "min":0, "max":1, "step":0.01}'
    - '// @input float curveSteps = 24 {"hint":"How many straight pieces make up the curved outline (more = smoother). Count.", "widget":"slider", "min":6, "max":64, "step":1}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Inside curve (crescent)</span>"}'
    - '// @ui {"widget":"group_start", "label":"Inside curve"}'
    - '// @input float innerCurveDepth = 1.2 {"hint":"How far the inside (toy-facing) edge bows toward the user at the centre (cm). 0 = flat inside edge (no crescent). It is kept at least Min Grip Thickness below the outside edge.", "widget":"slider", "min":0, "max":8, "step":0.1}'
    - '// @input float innerCurveRoundness = 0.6 {"hint":"Roundness of the inside curve. 1 = smooth half ellipse, 0 = squarish scoop with steep sides. 0 to 1, no unit.", "widget":"slider", "min":0, "max":1, "step":0.01}'
    - '// @input float minGripThickness = 0.8 {"hint":"Thinnest allowed grip between the inside and outside edges (cm). The inside curve is never allowed closer than this to the outside edge.", "widget":"slider", "min":0.1, "max":3, "step":0.1}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Touch box</span>"}'
    - '// @ui {"widget":"group_start", "label":"Touch box"}'
    - "// @input bool fitCollider = true {\"hint\":\"ON = this script sets the box collider on the parent (MoveHandle) to the handle's width and depth. OFF = you set the collider by hand in Lens Studio.\"}"
    - '// @input float colliderHeight = 1.5 {"hint":"Collider height above and below the floor (cm). Only used when Fit Collider is ON.", "widget":"slider", "min":0.5, "max":6, "step":0.1}'
    - '// @input float colliderMargin = 0.5 {"hint":"Extra collider margin added to the width and depth on every side (cm). A bigger box is easier to pinch. Only used when Fit Collider is ON.", "widget":"slider", "min":0, "max":5, "step":0.1}'
    - '// @ui {"widget":"group_end"}'
