    Node36:
      DependencyIndex: 36
      LevelID: 202
      NodeCount: 0
      NodeType: 1
      Ports:
        BandBottom:
          Connection0:
            NodeLevelID: 113
            PortID: Output
          Variable: 0.6
        BandTop:
          Connection0:
            NodeLevelID: 114
            PortID: Output
          Variable: 2.4
        Code:
          ClassType1: TEXT
          String: |
            input_float GlitterState;
            input_float GlitterEnergy;
            input_vec3 ToyAccel;
            input_float PieceSize;
            input_float SizeVariation;
            input_vec4 ColorA;
            input_vec4 ColorB;
            input_vec4 FlashColor;
            input_float FlashAmount;
            input_float ShineSharpness;
            input_float CountLow;
            input_float CountMed;
            input_float CountHigh;
            input_float BandBottom;
            input_float BandTop;
            input_float Radius;
            input_float Drift;
            input_float DriftSpeed;
            input_float EnergyDrift;
            input_float TumbleSpeed;
            input_float RiseAmount;
            input_float RiseSpeed;
            input_float PickupLag;
            input_float LagMax;
            input_float OutwardBias;
            input_float RisePhase;
            input_float PuffPhase;
            input_float DriftClock;
            input_float SwirlTurns;
            
            mat3 rotAxis(vec3 ax, float a)
            {
            	float c = cos(a);
            	float s = sin(a);
            	float t = 1.0 - c;
            	return mat3(
            		t * ax.x * ax.x + c,        t * ax.x * ax.y + s * ax.z, t * ax.x * ax.z - s * ax.y,
            		t * ax.x * ax.y - s * ax.z, t * ax.y * ax.y + c,        t * ax.y * ax.z + s * ax.x,
            		t * ax.x * ax.z + s * ax.y, t * ax.y * ax.z - s * ax.x, t * ax.z * ax.z + c);
            }
            
            void main()
            {
            	// Stable per-piece random numbers (no time, no node id, so they never change)
            	vec3 r1 = system.getParticleRandomVec3(true, false, false, 11.0);
            	vec3 r2 = system.getParticleRandomVec3(true, false, false, 23.0);
            	vec3 r3 = system.getParticleRandomVec3(true, false, false, 37.0);
            	vec4 r4 = system.getParticleRandomVec4(true, false, false, 51.0);
            	float t = system.getTimeElapsed();
            	float energy = clamp(GlitterEnergy, 0.0, 1.0);
            
            	// Home spot: inside an ellipsoid band (toy local space, +Y up)
            	float ang0 = r1.x * 6.2831853;
            	float h = max(BandTop - BandBottom, 0.01);
            	// Height 0..1: fixed per piece, or (Upward Movement) rising and looping
            	// Phase comes from the script (cycles), so changing the band size never makes pieces jump. Music puffs only ever add to it.
            	float fr0 = fract(r1.y + RisePhase + PuffPhase * (0.6 + 0.8 * r4.x));
            	float v = mix(r1.y, fr0, RiseAmount);
            	float rr = Radius * sqrt(r1.z) * sqrt(max(0.0, 1.0 - pow(2.0 * v - 1.0, 2.0)));
            	float ang = ang0 + SwirlTurns * 6.2831853 * mix(0.0, v, RiseAmount);
            	vec3 home = vec3(cos(ang) * rr, BandBottom + v * h, sin(ang) * rr);
            	// Outward Spread: fade out near the widest point instead of near the (narrow) top, so pieces only move up and out
            	float ob = clamp(OutwardBias, 0.0, 1.0);
            	float fadeStart = mix(0.85, 0.5, ob);
            	float fadeEnd = mix(1.0, 0.8, ob);
            	float edge = mix(1.0, smoothstep(0.0, 0.15, v) * (1.0 - smoothstep(fadeStart, fadeEnd, v)), RiseAmount);
            
            	// Drift: slow wander, bigger when the music is louder
            	float amp = Drift * ((1.0 - EnergyDrift) + EnergyDrift * energy);
            	vec3 ph = r2 * 6.2831853;
            	vec3 fr = (0.6 + r3 * 0.8) * DriftSpeed;
            	vec3 wander = vec3(sin(DriftClock * fr.x + ph.x), sin(DriftClock * fr.y + ph.y) * (1.0 - 0.8 * RiseAmount), sin(DriftClock * fr.z + ph.z)) * amp;
            
            	// Pickup: slide opposite to the toy's acceleration (nothing stored, so it catches up on its own)
            	vec3 lag = -ToyAccel * PickupLag * (0.5 + r4.x);
            	float lagLen = length(lag);
            	if (lagLen > LagMax) { lag *= LagMax / lagLen; }
            
            	system.setParticlePosition(home + wander + lag);
            	system.setParticleVelocity(vec3(0.0));
            	system.setParticleForce(vec3(0.0));
            
            	// How many pieces are showing at this state (piece index below the count = visible)
            	float s = clamp(GlitterState, 0.0, 3.0);
            	float cnt = s < 1.0 ? mix(0.0, CountLow, s) : (s < 2.0 ? mix(CountLow, CountMed, s - 1.0) : mix(CountMed, CountHigh, s - 2.0));
            	float vis = clamp(cnt - float(system.getParticleIndex()), 0.0, 1.0);
            	system.setParticleSize(PieceSize * mix(1.0 - SizeVariation, 1.0 + SizeVariation, r4.y) * vis * edge);
            
            	// Colour: random palette mix, plus a glint that is stronger with the music
            	// Specular: the piece flashes when its (two-sided) face turns toward a fixed light direction
            	vec3 axis = normalize(r3 * 2.0 - 1.0 + vec3(0.001));
            	mat3 rot = rotAxis(axis, r2.y * 6.2831853 + t * TumbleSpeed * (0.5 + r4.w));
            	vec3 nrm = rot * vec3(0.0, 0.0, 1.0);
            	float glint = pow(abs(dot(nrm, normalize(vec3(0.3, 0.8, 0.5)))), ShineSharpness) * FlashAmount * (0.4 + 0.6 * energy);
            	vec3 base = mix(ColorA.rgb, ColorB.rgb, r4.z);
            	vec3 col = mix(base, FlashColor.rgb, clamp(glint, 0.0, 1.0)) * (1.0 + max(0.0, glint - 1.0));
            	system.setParticleColor(vec4(col, 1.0));
            
            	system.setParticleMatrix(rot);
            }

        ColorA:
          Connection0:
            NodeLevelID: 105
            PortID: Output
          Variable: [1.0, 0.85, 0.4, 1.0]
        ColorB:
          Connection0:
            NodeLevelID: 106
            PortID: Output
          Variable: [0.6, 0.85, 1.0, 1.0]
        CountHigh:
